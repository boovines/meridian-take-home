# Copy to .env.local. Never commit the populated file.
# Production must use Supabase Postgres. Local development defaults to PGlite.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_ARTIFACT_BUCKET=meridian-artifacts
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSL_ROOT_CERT=
OPENAI_API_KEY=
OPENAI_REVIEW_MODEL=gpt-5.4-mini
COMPOSIO_API_KEY=
COMPOSIO_GMAIL_AUTH_CONFIG_ID=
COMPOSIO_GMAIL_CONNECTED_ACCOUNT_ID=
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=
TEMPORAL_TLS=true
TEMPORAL_TASK_QUEUE=meridian-studio
VERCEL_OIDC_TOKEN=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
OPENAI_ENGINEERING_MODEL=gpt-5.4-mini
OPENAI_RUNTIME_MODEL=gpt-5.4-mini
